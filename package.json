{
  "name": "ehs-smart-enterprise",
  "version": "2.1.0",
  "private": true,
  "description": "EHS Smart Enterprise — Plataforma de gestão EHS com Google Apps Script + Sheets",
  "scripts": {
    "lint": "eslint backend/*.js",
    "test": "jest --passWithNoTests",
    "deploy": "clasp push --force && clasp deploy"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testMatch": ["**/*.test.js"],
    "testPathIgnorePatterns": ["/node_modules/"],
    "moduleFileExtensions": ["js"],
    "testEnvironment": "node"
  }
}
